      {
        "parameters": {
          "jsCode": "const data = items.map(item => item.json);\n\nreturn [\n  {\n    json: {\n      success: true,\n      data,\n      meta: {\n        tool: 'search_emails',\n        count: data.length\n      }\n    }\n  }\n];"
