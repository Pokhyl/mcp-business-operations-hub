e: selected?.mime_type || null,\n      size: selected?.size ?? null,\n      available_attachments: candidates.map(item => ({\n        filename: item.filename,\n        mime_type: item.mime_type,\n        size: item.size\n      }))\n    }\n  }\n];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[496,-240],"id":"2e6f68f7-f5af-459a-ac07-e68f620ec10f","name":"Find attachment"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"2b0cbf62-8f82-4285-aa72-05d2509a18c9","leftValue":"={{ $json.attachment_found }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.3,"position":[720,-240],"id":"73a95b1f-91c6-4226-b491-84fd50531550","name":"Attachment found?"},{"parameters":{"jsCode":"const selection = $('Find attachment').first().json;\nconst ambiguous = selection.selection_status === 'ambiguous';\n\nreturn [\n  {\n    json: {\n      success: false,\n      error: {\n        code: ambiguous ? 'AMBIGUOUS_ATTACHMENT' : 'NOT_FOUND',\n        message: ambiguous\n          ? 'Multiple attachments found; retry with filename'\n          : 'No matching attachment found in message'\n      },\n      data: {\n        available_attachments: selection.available_attachments ?? []\n      },\n      meta: {\n        tool: 'get_email_attachment',\n        count: 0\n      }\n    }\n  }\n];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[944,-144],"id":"eea55028-f654-4f4f-8884-ec6f73ed524a","name":"Format not found error"},{"parameters":{"url":"={{   'https://gmail.googleapis.com/gmail/v1/users/me/messages/'   + $('Find attachment').item.json.message_id   + '/attachments/'   + $('Find attachment').item.json.attachment_id }}","authentication":"predefinedCredentialType","nodeCredentialType":"gmailOAuth2","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[944