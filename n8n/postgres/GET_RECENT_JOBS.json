        "parameters": {
          "jsCode": "const data = items.map(item => item.json);\n\nreturn [\n  {\n    json: {\n      success: true,\n      data,\n      meta: {\n        tool: 'get_recent_jobs',\n        count: data.length\n      }\n    }\n  }\n];"
