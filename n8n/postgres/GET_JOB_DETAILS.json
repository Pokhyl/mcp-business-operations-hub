      },
      {
        "parameters": {
          "jsCode": "const input = items[0]?.json ?? {};\nconst jobId = typeof input.job_id === 'string'\n  ? input.job_id.trim()\n  : '';\n\nconst isValidUuid =\n  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(jobId);\n\nreturn [\n  {\n    json: {\n      ...input,\n      job_id: jobId,\n      input_valid: isValidUuid\n    }\n  }\n];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -656,
          -112
        ],
        "id": "d5e51ce1-3205-4bdf-a0d3-25c198a867c7",
