      {
        "parameters": {
          "jsCode": "const data = items.map(item => item.json);\n\nreturn [\n  {\n    json: {\n      success: true,\n      data: data[0] ?? null,\n      meta: {\n        tool: 'get_job_details',\n        count: data.length\n      }\n    }\n  }\n];"
