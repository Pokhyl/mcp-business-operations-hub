          "jsCode": "const input = items[0]?.json ?? {};\n\nreturn [\n  {\n    json: {\n      success: false,\n      error: {\n        code: 'INVALID_INPUT',\n        message: 'job_id must be a valid UUID'\n      },\n      meta: {\n        tool: 'get_job_details',\n        count: 0\n      }\n    }\n  }\n];"
