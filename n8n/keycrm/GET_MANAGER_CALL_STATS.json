      "parameters": {
        "jsCode": "const manager = $('Resolve manager').first().json.manager;\nconst input = $('Validate input').first().json;\nconst calls = [];\nfor (const item of items) {\n  const page = item.json ?? {};\n  if (Array.isArray(page.data)) calls.push(...page.data);\n}\nconst incoming = calls.filter(c => c.type === 'incoming').length;\nconst outgoing = calls.filter(c => c.type === 'outgoing').length;\nconst finished = calls.filter(c => c.is_finished === true).length;\nconst totalDuration = calls.reduce((sum,c) => sum + (Number.isFinite(Number(c.duration)) ? Number(c.duration) : 0), 0);\nreturn [{ json: { success:true, data:{ manager, start:input.start_iso, end:input.end_iso, total_calls:calls.length, incoming_calls:incoming, outgoing_calls:outgoing, finished_calls:finished, unfinished_calls:calls.length-finished, total_duration_seconds:totalDuration }, meta:{ tool:'get_manager_call_stats', count:calls.length } } }];"
