    {
      "parameters": {
        "jsCode": "const query = $('Validate input').first().json.manager;\n\nfunction translit(value) {\n  const map = {\n    'а':'a','б':'b','в':'v','г':'g','ґ':'g','д':'d','е':'e','ё':'yo','є':'ye','ж':'zh','з':'z','и':'i','і':'i','ї':'yi','й':'i',\n    'к':'k','л':'l','м':'m','н':'n','о':'o','п':'p','р':'r','с':'s','т':'t','у':'u','ф':'f','х':'kh','ц':'ts','ч':'ch','ш':'sh','щ':'shch',\n    'ъ':'','ы':'y','ь':'','э':'e','ю':'yu','я':'ya'\n  };\n  return String(value ?? '').toLowerCase().split('').map(ch => map[ch] ?? ch).join('');\n}\n\nfunction normalize(value) {\n  return translit(value)\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^a-z0-9]+/g, ' ')\n    .trim()\n    .replace(/\\s+/g, ' ');\n}\n\nfunction levenshtein(a, b) {\n  if (a === b) return 0;\n  if (!a.length) return b.length;\n  if (!b.length) return a.length;\n  const prev = Array.from({ length: b.length + 1 }, (_, i) => i);\n  for (let i = 1; i <= a.length; i++) {\n    const cur = [i];\n    for (let j = 1; j <= b.length; j++) {\n      const cost = a[i - 1] === b[j - 1] ? 0 : 1;\n      cur[j] = Math.min(cur[j - 1] + 1, prev[j] + 1, prev[j - 1] + cost);\n    }\n    for (let j = 0; j <= b.length; j++) prev[j] = cur[j];\n  }\n  return prev[b.length];\n}\n\nfunction similarity(a, b) {\n  const maxLen = Math.max(a.length, b.length);\n  return maxLen === 0 ? 1 : 1 - levenshtein(a, b) / maxLen;\n}\n\nfunction tokenScore(a, b) {\n  const aa = a.split(' ').filter(Boolean);\n  const bb = b.split(' ').filter(Boolean);\n  if (!aa.length || !bb.length) return 0;\n  const oneWay = aa.reduce((sum, token) => sum + Math.max(...bb.map(x => similarity(token, x))), 0) / aa.length;\n  const reverse = bb.reduce((sum, token) => sum + Math.max(...aa.map(x => similarity(token, x))), 0) / bb.length;\n  return Math.min(oneWay, reverse);\n}\n\nconst users = [];\nfor (const item of items) {\n  const page = item.json ?? {};\n  if (Array.isArray(page.data)) users.push(...page.data);\n}\n\nconst q = normalize(query);\nconst ranked = users\n  .map(user => {\n    const name = String(user.full_name ?? `${user.first_name ?? ''} ${user.last_name ?? ''}`).trim();\n    const n = normalize(name);\n    const sortedQ = q.split(' ').sort().join(' ');\n    const sortedN = n.split(' ').sort().join(' ');\n    let score = Math.max(similarity(q, n), similarity(sortedQ, sortedN), tokenScore(q, n));\n    if (q === n) score = 1;\n    else if (q.length >= 4 && (n.includes(q) || q.includes(n))) score = Math.max(score, 0.96);\n    return { user, name, score };\n  })\n  .sort((a, b) => b.score - a.score || Number(a.user.id) - Number(b.user.id));\n\nconst best = ranked[0];\nconst second = ranked[1];\nif (!best || best.score < 0.78) {\n  return [{ json: { manager_resolved:false, error:{ code:'NOT_FOUND', message:'KeyCRM manager not found' } } }];\n}\nif (second && best.score < 0.97 && (best.score - second.score) < 0.06) {\n  return [{ json: { manager_resolved:false, error:{ code:'AMBIGUOUS_MANAGER', message:'Manager name is ambiguous; provide a more specific name' } } }];\n}\n\nreturn [{ json: {\n  manager_resolved:true,\n  manager:{ id:Number(best.user.id), full_name:best.name, status:best.user.status ?? null },\n  match_score:Number(best.score.toFixed(4))\n} }];"
      },
