      "id": "8a13b176-ca37-4242-8aad-8d4405c0e738",
      "name": "Fetch sources",
      "credentials": {
        "httpBearerAuth": {
          "id": "TGZJjiNcly8kxlkS",
          "name": "KeyCRM MCP"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const pipelines=$('Collect pipelines').first().json.pipelines ?? []; const sources=[]; for (const item of $('Fetch sources').all()) { if (Array.isArray(item.json?.data)) sources.push(...item.json.data); } const users=[]; for (const item of items) { if (Array.isArray(item.json?.data)) users.push(...item.json.data); } return [{json:{pipelines,sources,users,synced_at:new Date().toISOString()}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        0
      ],
      "id": "bd4d5439-1f5a-47ad-8cef-5f46d3eccb6a",
      "name": "Build reference payload"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH input AS (SELECT $1::jsonb AS pipelines,$2::jsonb AS sources,$3::jsonb AS users,$4::timestamptz AS synced_at),\npipeline_rows AS (\n SELECT (p->>'id')::bigint AS pipeline_id,COALESCE(p->>'title','') AS title,NULLIF(p->>'lead_type','') AS lead_type,NULLIF(p->>'updated_at','')::timestamptz AS keycrm_updated_at,input.synced_at\n FROM input CROSS JOIN LATERAL jsonb_array_elements(input.pipelines) p\n),\nup_p AS (\n INSERT INTO public.keycrm_pipelines(pipeline_id,title,lead_type,keycrm_updated_at,synced_at)\n SELECT pipeline_id,title,lead_type,keycrm_updated_at,synced_at FROM pipeline_rows\n ON CONFLICT(pipeline_id) DO UPDATE SET title=EXCLUDED.title,lead_type=EXCLUDED.lead_type,keycrm_updated_at=EXCLUDED.keycrm_updated_at,synced_at=EXCLUDED.synced_at RETURNING 1\n),\nsource_rows AS (\n SELECT (s->>'id')::bigint AS source_id,COALESCE(s->>'name','') AS name,NULLIF(s->>'alias','') AS alias,NULLIF(s->>'driver','') AS driver,NULLIF(s->>'updated_at','')::timestamptz AS keycrm_updated_at,input.synced_at\n FROM input CROSS JOIN LATERAL jsonb_array_elements(input.sources) s\n),\nup_s AS (\n INSERT INTO public.keycrm_sources(source_id,name,alias,driver,keycrm_updated_at,synced_at)\n SELECT source_id,name,alias,driver,keycrm_updated_at,synced_at FROM source_rows\n ON CONFLICT(source_id) DO UPDATE SET name=EXCLUDED.name,alias=EXCLUDED.alias,driver=EXCLUDED.driver,keycrm_updated_at=EXCLUDED.keycrm_updated_at,synced_at=EXCLUDED.synced_at RETURNING 1\n),\nuser_rows AS (\n SELECT (u->>'id')::bigint AS user_id,COALESCE(NULLIF(u->>'full_name',''),trim(COALESCE(u->>'first_name','')||' '||COALESCE(u->>'last_name','')),'') AS full_name,NULLIF(u->>'username','') AS username,NULLIF(u->>'status','') AS status,NULLIF(u->>'updated_at','')::timestamptz AS keycrm_updated_at,input.synced_at\n FROM input CROSS JOIN LATERAL jsonb_array_elements(input.users) u\n),\nup_u AS (\n INSERT INTO public.keycrm_users(user_id,full_name,username,status,keycrm_updated_at,synced_at)\n SELECT user_id,full_name,username,status,keycrm_updated_at,synced_at FROM user_rows\n ON CONFLICT(user_id) DO UPDATE SET full_name=EXCLUDED.full_name,username=EXCLUDED.username,status=EXCLUDED.status,keycrm_updated_at=EXCLUDED.keycrm_updated_at,synced_at=EXCLUDED.synced_at RETURNING 1\n)\nSELECT (SELECT count(*)::int FROM up_p) AS pipelines_synced,(SELECT count(*)::int FROM up_s) AS sources_synced,(SELECT count(*)::int FROM up_u) AS users_synced,$4::timestamptz AS synced_at;",
        "options": {
          "queryReplacement": "={{ [ JSON.stringify($json.pipelines), JSON.stringify($json.sources), JSON.stringify($json.users), $json.synced_at ] }}"
        }
      },
