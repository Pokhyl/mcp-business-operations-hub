    {
      "parameters": {
        "jsCode": "const syncedAt = new Date().toISOString();\nconst result = [];\n\nfor (const item of items) {\n  const response = item.json ?? {};\n\n  const buyers = Array.isArray(response.data)\n    ? response.data\n    : [];\n\n  for (const buyer of buyers) {\n    result.push({\n      json: {\n        buyer_id: String(buyer.id),\n\n        full_name:\n          typeof buyer.full_name === 'string'\n            ? buyer.full_name.trim()\n            : '',\n\n        phones:\n          Array.isArray(buyer.phone)\n            ? buyer.phone\n                .filter((value) => typeof value === 'string')\n                .map((value) => value.trim())\n                .filter(Boolean)\n            : [],\n\n        emails:\n          Array.isArray(buyer.email)\n            ? buyer.email\n                .filter((value) => typeof value === 'string')\n                .map((value) => value.trim().toLowerCase())\n                .filter(Boolean)\n            : [],\n\n        keycrm_updated_at:\n          buyer.updated_at || null,\n\n        synced_at: syncedAt\n      }\n    });\n  }\n}\n\nreturn result;"
      },
