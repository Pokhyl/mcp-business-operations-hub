      "id": "60d9e2c0-fdea-4fab-a76b-877fc9673dd3",
      "name": "Get latest buyer",
      "credentials": {
        "httpBearerAuth": {
          "id": "TGZJjiNcly8kxlkS",
          "name": "KeyCRM MCP"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = items[0]?.json ?? {};\n\nconst latestBuyer =\n  Array.isArray(response.data) && response.data.length > 0\n    ? response.data[0]\n    : null;\n\nconst maxBuyerId = Number(latestBuyer?.id);\n\nif (!Number.isInteger(maxBuyerId) || maxBuyerId < 1) {\n  throw new Error('Could not determine latest KeyCRM buyer ID');\n}\n\nconst batchSize = 50;\nconst batches = [];\n\nfor (let startId = 1; startId <= maxBuyerId; startId += batchSize) {\n  const endId = Math.min(startId + batchSize - 1, maxBuyerId);\n\n  const ids = [];\n\n  for (let id = startId; id <= endId; id++) {\n    ids.push(id);\n  }\n\n  batches.push({\n    start_id: startId,\n    end_id: endId,\n    buyer_ids: ids.join(',')\n  });\n}\n\nconst batchCount = batches.length;\n\nreturn batches.map((batch, index) => ({\n  json: {\n    batch_number: index + 1,\n    batch_count: batchCount,\n    max_buyer_id: maxBuyerId,\n    ...batch\n  }\n}));"
      },
