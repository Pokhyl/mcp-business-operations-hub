      "id": "4632581b-a4aa-4d7a-a966-d2e227e90d30",
      "name": "Audit start"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH input AS (\n    SELECT $1::text AS q, lower($1::text) AS q_lower,\n           regexp_replace($1::text, '[^0-9]', '', 'g') AS q_digits,\n           $2::int AS result_limit\n), candidates AS (\n    SELECT c.buyer_id,c.full_name,c.phones,c.emails,c.keycrm_updated_at,\n      CASE WHEN c.buyer_id::text=i.q THEN 1000\n           WHEN EXISTS (SELECT 1 FROM unnest(c.emails) e WHERE lower(e)=i.q_lower) THEN 950\n           WHEN length(i.q_digits)>=4 AND EXISTS (SELECT 1 FROM unnest(c.phones) p WHERE regexp_replace(p,'[^0-9]','','g')=i.q_digits) THEN 900\n           WHEN lower(c.full_name)=i.q_lower THEN 850\n           WHEN lower(c.full_name) LIKE i.q_lower||'%' THEN 800\n           WHEN lower(c.full_name) LIKE '%'||i.q_lower||'%' THEN 750\n           WHEN EXISTS (SELECT 1 FROM unnest(c.emails) e WHERE lower(e) LIKE '%'||i.q_lower||'%') THEN 700\n           WHEN length(i.q_digits)>=4 AND EXISTS (SELECT 1 FROM unnest(c.phones) p WHERE regexp_replace(p,'[^0-9]','','g') LIKE '%'||i.q_digits||'%') THEN 650\n           ELSE (similarity(lower(c.full_name),i.q_lower)*500)::int END AS score\n    FROM public.keycrm_customers c CROSS JOIN input i\n    WHERE c.buyer_id::text=i.q OR lower(c.full_name) LIKE '%'||i.q_lower||'%'\n       OR (length(i.q_lower)>=2 AND lower(c.full_name) % i.q_lower)\n       OR EXISTS (SELECT 1 FROM unnest(c.emails) e WHERE lower(e)=i.q_lower OR lower(e) LIKE '%'||i.q_lower||'%')\n       OR (length(i.q_digits)>=4 AND EXISTS (SELECT 1 FROM unnest(c.phones) p WHERE regexp_replace(p,'[^0-9]','','g') LIKE '%'||i.q_digits||'%'))\n), selected AS (\n    SELECT * FROM candidates ORDER BY score DESC,lower(full_name),buyer_id\n    LIMIT (SELECT result_limit FROM input)\n)\nSELECT COALESCE(jsonb_agg(jsonb_build_object('buyer_id',buyer_id,'full_name',full_name,'phones',to_jsonb(phones),'emails',to_jsonb(emails),'keycrm_updated_at',keycrm_updated_at) ORDER BY score DESC,lower(full_name),buyer_id),'[]'::jsonb) AS customers FROM selected;",
        "options": {
          "queryReplacement": "={{ [ $('Validate input').first().json.query, $('Validate input').first().json.limit ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
