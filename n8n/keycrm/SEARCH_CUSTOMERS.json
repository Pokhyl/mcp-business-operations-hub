    {
      "parameters": {
        "jsCode": "const input = items[0]?.json ?? {};\n\nconst query =\n  typeof input.query === 'string'\n    ? input.query.trim()\n    : '';\n\nconst hasLimit =\n  input.limit !== undefined &&\n  input.limit !== null &&\n  input.limit !== '';\n\nconst limit = hasLimit\n  ? Number(input.limit)\n  : 10;\n\nconst inputValid =\n  query.length > 0 &&\n  Number.isInteger(limit) &&\n  limit >= 1 &&\n  limit <= 50;\n\nreturn [\n  {\n    json: {\n      ...input,\n      query,\n      limit,\n      input_valid: inputValid\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
