    {
      "parameters": {
        "jsCode": "const response = items[0]?.json ?? {};\nconst customers = Array.isArray(response.customers) ? response.customers : [];\nconst data = customers.map((customer) => ({ buyer_id: customer.buyer_id ?? null, full_name: customer.full_name ?? '', phones: Array.isArray(customer.phones) ? customer.phones : [], emails: Array.isArray(customer.emails) ? customer.emails : [], keycrm_updated_at: customer.keycrm_updated_at ?? null }));\nreturn [{ json: { success: true, data, meta: { tool: 'search_customers', count: data.length } } }];"
      },
      "type": "n8n-nodes-base.code",
