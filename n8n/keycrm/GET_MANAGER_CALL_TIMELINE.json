    {
      "parameters": {
        "jsCode": "const manager = $('Resolve manager').first().json.manager;\nconst input = $('Validate input').first().json;\nconst calls = [];\nfor (const item of items) {\n  const page = item.json ?? {};\n  if (Array.isArray(page.data)) calls.push(...page.data);\n}\n\nconst normalized = calls\n  .map(c => {\n    const startMs = Date.parse(c.created_at || '');\n    const duration = Number.isFinite(Number(c.duration)) ? Math.max(0, Number(c.duration)) : 0;\n    const endMs = Number.isFinite(startMs) ? startMs + duration * 1000 : NaN;\n    return {\n      id: Number(c.id),\n      type: c.type ?? null,\n      state: c.state ?? null,\n      created_at: Number.isFinite(startMs) ? new Date(startMs).toISOString() : (c.created_at ?? null),\n      end_at: Number.isFinite(endMs) ? new Date(endMs).toISOString() : null,\n      duration_seconds: duration,\n      is_finished: c.is_finished === true,\n      lead_id: Number.isInteger(Number(c.lead_id)) ? Number(c.lead_id) : null,\n      client_id: Number.isInteger(Number(c.client_id)) ? Number(c.client_id) : null\n    };\n  })\n  .filter(c => c.created_at)\n  .sort((a,b) => Date.parse(a.created_at) - Date.parse(b.created_at) || a.id - b.id);\n\nconst gaps = [];\nfor (let i = 1; i < normalized.length; i++) {\n  const prev = normalized[i-1];\n  const next = normalized[i];\n  const prevEnd = Date.parse(prev.end_at || prev.created_at);\n  const nextStart = Date.parse(next.created_at);\n  if (!Number.isFinite(prevEnd) || !Number.isFinite(nextStart)) continue;\n  const rawSeconds = Math.round((nextStart - prevEnd) / 1000);\n  gaps.push({\n    after_call_id: prev.id,\n    before_call_id: next.id,\n    from: new Date(prevEnd).toISOString(),\n    to: new Date(nextStart).toISOString(),\n    gap_seconds: Math.max(0, rawSeconds),\n    gap_minutes: Number((Math.max(0, rawSeconds) / 60).toFixed(1)),\n    overlap_seconds: rawSeconds < 0 ? Math.abs(rawSeconds) : 0\n  });\n}\nconst positive = gaps.map(g => g.gap_seconds).filter(v => v > 0);\nconst avg = positive.length ? positive.reduce((a,b)=>a+b,0)/positive.length : 0;\nconst longest = positive.length ? Math.max(...positive) : 0;\nconst maxReturned = 250;\nreturn [{ json: {\n  success: true,\n  data: {\n    manager,\n    start: input.start_iso,\n    end: input.end_iso,\n    total_calls: normalized.length,\n    returned_calls: Math.min(normalized.length, maxReturned),\n    truncated: normalized.length > maxReturned,\n    calls: normalized.slice(0,maxReturned),\n    gaps: gaps.slice(0,maxReturned),\n    average_positive_gap_minutes: Number((avg/60).toFixed(1)),\n    longest_gap_minutes: Number((longest/60).toFixed(1)),\n    gaps_over_15_minutes: gaps.filter(g => g.gap_seconds >= 900).length,\n    gaps_over_30_minutes: gaps.filter(g => g.gap_seconds >= 1800).length\n  },\n  meta: { tool:'get_manager_call_timeline', count: normalized.length }\n} }];"
