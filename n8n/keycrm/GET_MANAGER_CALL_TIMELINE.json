      "parameters": {
        "jsCode": "const input = items[0]?.json ?? {};\nconst manager = typeof input.manager === 'string' ? input.manager.trim() : '';\nconst start = typeof input.start === 'string' ? input.start.trim() : '';\nconst end = typeof input.end === 'string' ? input.end.trim() : '';\nconst startMs = Date.parse(start);\nconst endMs = Date.parse(end);\nconst hasTz = (value) => /(Z|[+-]\\d{2}:\\d{2})$/i.test(value);\nconst maxWindowMs = 31 * 24 * 60 * 60 * 1000;\nconst inputValid = manager.length >= 2 && manager.length <= 200 && Number.isFinite(startMs) && Number.isFinite(endMs) && hasTz(start) && hasTz(end) && endMs > startMs && (endMs - startMs) <= maxWindowMs;\nreturn [{ json: { ...input, manager, start, end, start_iso: Number.isFinite(startMs) ? new Date(startMs).toISOString() : null, end_iso: Number.isFinite(endMs) ? new Date(endMs).toISOString() : null, input_valid: inputValid } }];"
