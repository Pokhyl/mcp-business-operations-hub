    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH meta AS (\n  INSERT INTO public.keycrm_pipeline_tracking_meta(id,tracking_started_at)\n  VALUES(1,now())\n  ON CONFLICT(id) DO UPDATE SET tracking_started_at=EXCLUDED.tracking_started_at\n  RETURNING tracking_started_at\n), state AS (\n  INSERT INTO public.keycrm_sync_state(sync_name,last_successful_sync_at,last_count,updated_at)\n  VALUES('pipeline_cards_incremental',$1::timestamptz,0,now())\n  ON CONFLICT(sync_name) DO UPDATE SET last_successful_sync_at=EXCLUDED.last_successful_sync_at,last_count=0,updated_at=now()\n  RETURNING last_successful_sync_at\n)\nSELECT (SELECT tracking_started_at FROM meta) AS tracking_started_at,(SELECT last_successful_sync_at FROM state) AS incremental_checkpoint,(SELECT count(*)::int FROM public.keycrm_pipeline_cards) AS indexed_cards;",
        "options": {
          "queryReplacement": "={{ [ $('Capture bootstrap start').first().json.bootstrap_started_at ] }}"
        }
