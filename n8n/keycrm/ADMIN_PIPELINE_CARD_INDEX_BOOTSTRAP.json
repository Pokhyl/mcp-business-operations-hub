      "name": "Has cards?"
    },
    {
      "parameters": {
        "jsCode": "const syncedAt = new Date().toISOString();\nconst out = [];\nfor (const item of items) {\n  const cards = Array.isArray(item.json?.data) ? item.json.data : [];\n  for (const card of cards) {\n    const cardId = Number(card.id);\n    const pipelineId = Number(card.pipeline_id);\n    if (!Number.isInteger(cardId) || cardId < 1 || !Number.isInteger(pipelineId) || pipelineId < 1) continue;\n    out.push({ json: {\n      card_id: cardId,\n      pipeline_id: pipelineId,\n      source_id: Number.isInteger(Number(card.source_id)) ? Number(card.source_id) : null,\n      manager_id: Number.isInteger(Number(card.manager_id)) ? Number(card.manager_id) : null,\n      status_id: Number.isInteger(Number(card.status_id)) ? Number(card.status_id) : null,\n      status_alias: typeof card.status?.alias === 'string' ? card.status.alias : null,\n      status_title: typeof card.status?.title === 'string' ? card.status.title : null,\n      status_is_final: typeof card.status?.is_final === 'boolean' ? card.status.is_final : null,\n      is_finished: typeof card.is_finished === 'boolean' ? card.is_finished : null,\n      closed_from: Number.isInteger(Number(card.closed_from)) ? Number(card.closed_from) : null,\n      created_at: card.created_at || null,\n      updated_at: card.updated_at || null,\n      status_changed_at: card.status_changed_at || null,\n      payments_total: Number.isFinite(Number(card.payments_total)) ? Number(card.payments_total) : 0,\n      products_total: Number.isFinite(Number(card.products_total)) ? Number(card.products_total) : 0,\n      utm_source: typeof card.utm_source === 'string' ? card.utm_source : null,\n      utm_medium: typeof card.utm_medium === 'string' ? card.utm_medium : null,\n      utm_campaign: typeof card.utm_campaign === 'string' ? card.utm_campaign : null,\n      synced_at: syncedAt\n    }});\n  }\n}\nreturn out;"
      },
