    {
      "parameters": {
        "jsCode": "const response = items[0]?.json ?? {};\nconst lastPage = Number(response.last_page);\nconst total = Number(response.total ?? 0);\nif (!Number.isInteger(lastPage) || lastPage < 1) {\n  throw new Error('Could not determine KeyCRM pipeline-card last_page');\n}\nreturn Array.from({ length: lastPage }, (_, i) => ({\n  json: { page: i + 1, last_page: lastPage, total }\n}));"
      },
