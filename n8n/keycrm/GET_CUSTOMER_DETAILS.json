        "jsCode": "const input = items[0]?.json ?? {};\nconst raw = input.buyer_id;\nconst buyerId = typeof raw === 'number' ? raw : Number(String(raw ?? '').trim());\nconst inputValid = Number.isInteger(buyerId) && buyerId > 0;\nreturn [{ json: { ...input, buyer_id: inputValid ? buyerId : raw, input_valid: inputValid } }];"
