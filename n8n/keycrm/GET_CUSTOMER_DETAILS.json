    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const buyer = items[0]?.json ?? {};\nconst data = {\n  buyer_id: Number(buyer.id),\n  company_id: buyer.company_id ?? null,\n  full_name: buyer.full_name ?? '',\n  birthday: buyer.birthday ?? null,\n  phones: Array.isArray(buyer.phone) ? buyer.phone : [],\n  emails: Array.isArray(buyer.email) ? buyer.email : [],\n  note: buyer.note ?? null,\n  orders_sum: buyer.orders_sum ?? null,\n  discount: buyer.discount ?? null,\n  currency: buyer.currency ?? null,\n  orders_count: buyer.orders_count ?? null,\n  has_duplicates: buyer.has_duplicates ?? null,\n  manager_id: buyer.manager_id ?? null,\n  deleted_at: buyer.deleted_at ?? null,\n  created_at: buyer.created_at ?? null,\n  updated_at: buyer.updated_at ?? null\n};\nreturn [{ json: { success: true, data, meta: { tool: 'get_customer_details', count: 1 } } }];"
      },
