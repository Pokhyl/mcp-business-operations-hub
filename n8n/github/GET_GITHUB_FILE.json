        "onError": "continueErrorOutput"
      },
      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "const encoded = $json.content;\n\nif (typeof encoded !== 'string' || !encoded) {\n  throw new Error('GitHub response does not contain file content');\n}\n\nconst content = Buffer\n  .from(encoded.replace(/\\s/g, ''), 'base64')\n  .toString('utf8');\n\nreturn {\n  json: {\n    name: $json.name,\n    path: $json.path,\n    sha: $json.sha,\n    content\n  }\n};"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -144,
          -64
        ],
        "id": "ade81c78-3510-4dbe-8fb0-1b2f244c930b",
        "name": "Decode GitHub Content"
      },
      {
        "parameters": {
          "jsCode": "const data = items[0]?.json ?? null;\n\nreturn [\n  {\n    json: {\n      success: true,\n      data,\n      meta: {\n        tool: 'get_github_file',\n        count: data ? 1 : 0\n      }\n    }\n  }\n];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          80,
          -64
        ],
        "id": "801335d3-6557-4165-9527-31befddca90c",
        "name": "Format MCP response"
      },
      {
        "parameters": {
          "jsCode": "const input = items[0]?.json ?? {};\n\nconst message =\n  typeof input.error === 'string' && input.error.trim()\n    ? input.error.trim()\n    : 'GitHub request failed';\n\nconst code =\n  /not found|could not be found/i.test(message)\n    ? 'NOT_FOUND'\n    : 'UPSTREAM_ERROR';\n\nreturn [\n  {\n    json: {\n      success: false,\n      error: {\n        code,\n        message\n      },\n      meta: {\n        tool: 'get_github_file',\n        count: 0\n      }\n    }\n  }\n];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
